<UserControl x:Class="DrivingSchool.App.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:DrivingSchool.App.Infrastructure">
    <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="Gray" Margin="0,6,0,0"/>
        <WrapPanel DockPanel.Dock="Top">
            <TextBlock Text="Група:" VerticalAlignment="Center" Margin="0,0,6,8"/>
            <ComboBox Width="140" ItemsSource="{Binding Groups}" DisplayMemberPath="Name" SelectedItem="{Binding Group}"/>
            <Button Content="Усі учні" Command="{Binding AllGroupsCommand}" Margin="10,0,6,8"/>
            <Button Content="Оновити" Command="{Binding RefreshCommand}" Margin="0,0,6,8"/>
            <Button Content="Експорт у CSV" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,8"/>
        </WrapPanel>
        <Border DockPanel.Dock="Right" Width="320" Style="{StaticResource FormPanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Картка прогресу" Style="{StaticResource Header}"/>
                    <TextBlock Text="{Binding Selected.StudentName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Selected.StageText}" Foreground="#1F5FA8" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <TextBlock Text="Теорія (відвідуваність):"/>
                    <ProgressBar Height="14" Maximum="100" Value="{Binding Selected.TheoryAttendancePercent, Mode=OneWay}" Margin="0,2,0,8"/>
                    <TextBlock Text="Практика (години водіння):"/>
                    <ProgressBar Height="14" Maximum="100" Value="{Binding Selected.DrivingPercent, Mode=OneWay}" Margin="0,2,0,8"/>
                    <TextBlock Text="Оцінки учня:" FontWeight="SemiBold" Margin="0,4,0,4"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding SelectedGrades}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM}" Width="50"/>
                        <DataGridTextColumn Header="Вид" Binding="{Binding TypeName}" Width="*"/>
                        <DataGridTextColumn Header="Бал" Binding="{Binding Score}" Width="40"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Учень" Binding="{Binding StudentName}" Width="2*"/>
                <DataGridTextColumn Header="Група" Binding="{Binding GroupName}" Width="60"/>
                <DataGridTextColumn Header="Теорія, %" Binding="{Binding TheoryAttendancePercent}" Width="75"/>
                <DataGridTextColumn Header="Водіння, год" Binding="{Binding DrivingHoursCompleted}" Width="90"/>
                <DataGridTextColumn Header="Бал теорія" Binding="{Binding AverageTheoryScore}" Width="80"/>
                <DataGridTextColumn Header="Бал водіння" Binding="{Binding AverageDrivingScore}" Width="85"/>
                <DataGridTextColumn Header="Етап навчання" Binding="{Binding StageText}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
