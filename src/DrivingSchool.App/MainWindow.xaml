<Window x:Class="DrivingSchool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DrivingSchool.App.Views"
        Title="Автошкола: розклад і навчальний процес"
        Width="1280" Height="760" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="АВТОШКОЛА" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="  система формування та управління розкладом занять" Foreground="#D6E4F5"
                           FontSize="14" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Border>
        <TabControl x:Name="Tabs" Margin="8" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Учні">
                <views:StudentsView DataContext="{Binding Students}"/>
            </TabItem>
            <TabItem Header="Інструктори">
                <views:InstructorsView DataContext="{Binding Instructors}"/>
            </TabItem>
            <TabItem Header="Автомобілі">
                <views:VehiclesView DataContext="{Binding Vehicles}"/>
            </TabItem>
            <TabItem Header="Групи">
                <views:GroupsView DataContext="{Binding Groups}"/>
            </TabItem>
            <TabItem Header="Розклад">
                <views:ScheduleView DataContext="{Binding Schedule}"/>
            </TabItem>
            <TabItem Header="Запис на водіння">
                <views:BookingView DataContext="{Binding Booking}"/>
            </TabItem>
            <TabItem Header="Журнал відвідувань">
                <views:AttendanceView DataContext="{Binding Attendance}"/>
            </TabItem>
            <TabItem Header="Успішність і прогрес">
                <views:ProgressView DataContext="{Binding Progress}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
